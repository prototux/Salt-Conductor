# Salt Conductor configuration (docker compose reads this file as .env)

# Image tag to run (latest, a release like 1.0.0, or a commit sha)
CONDUCTOR_VERSION=latest
# Address:port published on the host
CONDUCTOR_LISTEN=127.0.0.1:8080

# Session signing key. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# (if empty, a key is generated once and stored in the data volume)
CONDUCTOR_SECRET_KEY=
# Behind a TLS reverse proxy: number of proxies to trust, and secure cookies
CONDUCTOR_PROXY_FIX=1
CONDUCTOR_COOKIE_SECURE=true

# salt-api (rest_cherrypy) and the eauth backends offered on the login page
CONDUCTOR_SALT_API_URL=https://salt-master.example.org:8000
CONDUCTOR_SALT_API_VERIFY_SSL=true
CONDUCTOR_EAUTH_BACKENDS=ldap,pam
CONDUCTOR_DEFAULT_EAUTH=ldap

# PostgreSQL shared with the salt-master (job cache, events, database pillar)
CONDUCTOR_DATABASE_URL=postgresql://salt:CHANGE-ME@db.example.org:5432/salt
# only used by the optional bundled database (docker compose --profile postgres)
POSTGRES_DB=salt
POSTGRES_USER=salt
POSTGRES_PASSWORD=CHANGE-ME

# OpenBao / Vault (leave the token empty to disable the Secrets pages)
CONDUCTOR_OPENBAO_URL=https://openbao.example.org:8200
CONDUCTOR_OPENBAO_TOKEN=
CONDUCTOR_OPENBAO_SALT_MOUNT=secret
CONDUCTOR_OPENBAO_SALT_PREFIX=salt

# Git remotes served to the master by gitfs (states) and git_pillar (pillar)
CONDUCTOR_STATES_REPO=git@git.example.org:infra/salt-states.git
CONDUCTOR_PILLAR_REPO=git@git.example.org:infra/salt-pillar.git
CONDUCTOR_GIT_DEFAULT_BRANCH=main
CONDUCTOR_GIT_AUTO_DEPLOY=true
# e.g. to pin the host key file used for SSH remotes
# GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/home/conductor/.ssh/known_hosts

# Gunicorn
CONDUCTOR_WORKERS=2
CONDUCTOR_THREADS=16
CONDUCTOR_LOG_LEVEL=info
